{% set ctx = obj.get_config_context() %}
{% set mgmt_vrf = ctx.mgmt_vrf | default('') %}
{% set vrfp = ('vrf ' ~ mgmt_vrf ~ ' ') if mgmt_vrf else '' %}
!
{# ─────────────────── COMPLIANCE POLICY ─────────────────── #}
{# Each marker is a require/forbid check mapped to frameworks. They are pure #}
{# Jinja comments (never rendered) and drive the per-framework compliance report. #}
{# The report is compliant for a framework only when every check tagged with it passes. #}
{# compliance: ssh-enabled       | frameworks: CIS,STIG,PCI,HIPAA,NIST | require: ^management ssh #}
{# compliance: telnet-disabled   | frameworks: CIS,STIG,PCI,HIPAA,GDPR | forbid: ^management telnet #}
{# compliance: snmpv3-only       | frameworks: CIS,STIG,PCI,HIPAA,NIST | require: ^snmp-server group \S+ v3 priv #}
{# compliance: snmp-no-community | frameworks: CIS,STIG,PCI,HIPAA      | forbid: ^snmp-server community #}
{# compliance: aaa-authentication| frameworks: CIS,STIG,NIST,SOX       | require: ^aaa authentication login #}
{# compliance: command-accounting| frameworks: STIG,SOX,NIST           | require: ^aaa accounting commands #}
{# compliance: central-syslog    | frameworks: PCI,HIPAA,SOX,NIST,STIG | require: ^logging (vrf \S+ )?host #}
{# compliance: ntp-configured    | frameworks: PCI,NIST,STIG           | require: ^ntp server #}
{# compliance: login-banner      | frameworks: CIS,STIG,NIST           | require: ^banner (login|motd) #}
{# compliance: session-timeout   | frameworks: CIS,STIG,NIST           | require: idle-timeout \d+ #}
{# compliance: mgmt-acl          | frameworks: CIS,STIG,NIST           | require: ip access-group \S+ in|access-class #}
{# compliance: no-nopassword     | frameworks: CIS,STIG,PCI            | forbid: allow-nopassword #}
{# ───────────────── END COMPLIANCE POLICY ───────────────── #}
!
{# feature: system | detect: ^service routing protocols model #}
no aaa root
service routing protocols model {{ ctx.routing_model | default('multi-agent') }}
{# endfeature #}
!
{# feature: hostname | detect: ^hostname #}
hostname {{ obj.name }}
ip domain-name {{ ctx.domain_name | default('enterprise.local') }}
{# endfeature #}
!
{# feature: users | detect: ^username #}
username admin privilege 15 role network-admin secret sha512 {{ ctx.admin_secret_hash | default('$6$placeholder$changeme') }}
{% for u in ctx.users | default([]) %}
username {{ u.name }} privilege {{ u.privilege | default('15') }} role {{ u.role | default('network-operator') }} secret sha512 {{ u.secret_hash }}
{% endfor %}
{# endfeature #}
!
{# feature: aaa | detect: ^aaa |^tacacs-server|^radius-server #}
aaa authentication login default group tacacs+ local
{% for s in ctx.tacacs_servers | default([]) %}
tacacs-server host {{ s.host }} {{ vrfp }}key 7 {{ s.key }}
{% endfor %}
{# endfeature #}
!
{# feature: dns | detect: ^ip name-server #}
{% for d in ctx.dns_servers | default([ctx.dns_server | default('172.20.21.100')]) %}
ip name-server {{ vrfp }}{{ d }}
{% endfor %}
{# endfeature #}
!
{# feature: clock | detect: ^clock timezone #}
clock timezone {{ ctx.timezone | default('UTC') }}
{# endfeature #}
!
{# feature: ntp | detect: ^ntp #}
{% for s in ctx.ntp_servers | default([ctx.ntp_server | default('172.20.21.100')]) %}
ntp server {{ vrfp }}{{ s }}
{% endfor %}
{# endfeature #}
!
{# feature: snmp | detect: ^snmp-server #}
snmp-server contact {{ ctx.snmp_contact | default('noc@enterprise.local') }}
snmp-server location {{ ctx.snmp_location | default('set-location') }}
snmp-server enable traps
{% if ctx.snmp_host is defined %}
snmp-server host {{ ctx.snmp_host }} {{ vrfp }}version 3 priv {{ ctx.snmp_user | default('monitor') }}
{% endif %}
{# endfeature #}
!
{# feature: logging | detect: ^logging #}
{% for h in ctx.syslog_hosts | default([ctx.syslog_server | default('172.20.21.1')]) %}
logging {{ vrfp }}host {{ h }}{{ (' ' ~ ctx.syslog_port) if ctx.syslog_port is defined else '' }}
{% endfor %}
{# endfeature #}
!
{# feature: banner | detect: ^banner #}
banner login
{{ ctx.login_banner | default('WARNING: Authorized access only. All activity is logged and monitored.') }}
EOF
{# endfeature #}
!
{# feature: management-vrf | detect: ^(ip|ipv6) route vrf #}
{% if mgmt_vrf %}
vrf instance {{ mgmt_vrf }}
{% endif %}
{% if ctx.mgmt_default_gateway is defined %}
ip route {{ vrfp }}0.0.0.0/0 {{ ctx.mgmt_default_gateway }}
{% endif %}
{# endfeature #}
!
{# feature: management-ssh | detect: ^management ssh #}
management ssh
   idle-timeout {{ ctx.ssh_idle_timeout | default(15) }}
   no shutdown
{# endfeature #}
!
{# feature: management-api | detect: ^management api #}
management api http-commands
   no shutdown
   protocol https
{# endfeature #}
!
{# feature: lldp | detect: ^lldp #}
lldp run
{# endfeature #}
!
{# feature: spanning-tree | detect: ^spanning-tree #}
spanning-tree mode {{ ctx.spanning_tree_mode | default('mstp') }}
{# endfeature #}
!
{# feature: vlans | detect: ^vlan #}
{% for v in ctx.vlans | default([]) %}
vlan {{ v.id }}
   name {{ v.name | default('VLAN' ~ v.id) }}
!
{% endfor %}
{# endfeature #}
!
{# feature: interfaces | detect: ^interface Ethernet|^interface Port-Channel #}
{% for i in ctx.routed_interfaces | default([]) %}
interface {{ i.name }}
   description {{ i.description | default('ROUTED') }}
   no switchport
   ip address {{ i.ip_address }}
!
{% endfor %}
{% for i in ctx.switched_interfaces | default([]) %}
interface {{ i.name }}
   description {{ i.description | default('ACCESS') }}
{% if i.mode | default('access') == 'access' %}
   switchport access vlan {{ i.vlan | default(1) }}
{% else %}
   switchport mode trunk
{% if i.trunk_vlans is defined %}
   switchport trunk allowed vlan {{ i.trunk_vlans }}
{% endif %}
{% endif %}
!
{% endfor %}
{# endfeature #}
!
{# feature: unused-interfaces | detect: ^interface Ethernet #}
{% for i in ctx.unused_interfaces | default([]) %}
interface {{ i }}
   description UNUSED
   shutdown
!
{% endfor %}
{# endfeature #}
!
{# feature: ip-routing | detect: ^ip routing #}
ip routing
{# endfeature #}
!
{# feature: static-routes | detect: ^ip route #}
{% if ctx.default_gateway is defined %}
ip route 0.0.0.0/0 {{ ctx.default_gateway }}
{% endif %}
{% for r in ctx.static_routes | default([]) %}
ip route {{ r.prefix }} {{ r.next_hop }}
{% endfor %}
{# endfeature #}
!
{# feature: ospf | detect: ^router ospf #}
{% if ctx.ospf is defined %}
router ospf {{ ctx.ospf.process | default(1) }}
   router-id {{ ctx.ospf.router_id }}
{% for n in ctx.ospf.networks | default([]) %}
   network {{ n.prefix }} area {{ n.area }}
{% endfor %}
{% endif %}
{# endfeature #}
!
{# feature: bgp | detect: ^router bgp #}
{% if ctx.bgp is defined %}
router bgp {{ ctx.bgp.asn }}
   router-id {{ ctx.bgp.router_id }}
{% for nb in ctx.bgp.neighbors | default([]) %}
   neighbor {{ nb.ip }} remote-as {{ nb.remote_as }}
{% if nb.description is defined %}
   neighbor {{ nb.ip }} description {{ nb.description }}
{% endif %}
{% endfor %}
{% for net in ctx.bgp.networks | default([]) %}
   network {{ net }}
{% endfor %}
{% endif %}
{# endfeature #}
!
{# feature: prefix-lists | detect: ^ip prefix-list #}
{% for pl in ctx.prefix_lists | default([]) %}
{% for e in pl.entries %}
ip prefix-list {{ pl.name }} seq {{ e.seq }} {{ e.action }} {{ e.prefix }}{{ (' le ' ~ e.le) if e.le is defined else '' }}
{% endfor %}
{% endfor %}
{# endfeature #}
!
{# feature: route-maps | detect: ^route-map #}
{% for rm in ctx.route_maps | default([]) %}
{% for e in rm.entries %}
route-map {{ rm.name }} {{ e.action }} {{ e.seq }}
{% for m in e.match | default([]) %}
   match {{ m }}
{% endfor %}
{% for s in e.set | default([]) %}
   set {{ s }}
{% endfor %}
!
{% endfor %}
{% endfor %}
{# endfeature #}
!
{# feature: acls | detect: ^ip access-list #}
{% for acl in ctx.acls | default([]) %}
ip access-list {{ acl.name }}
{% for e in acl.entries %}
   {{ e.seq }} {{ e.action }} {{ e.rule }}
{% endfor %}
!
{% endfor %}
{# endfeature #}
!
{# feature: control-plane | detect: ^policy-map type copp|^control-plane #}
{% if ctx.copp_policy is defined %}
control-plane
   service-policy input {{ ctx.copp_policy }}
{% endif %}
{# endfeature #}
!
{# feature: qos | detect: ^class-map|^policy-map type qos #}
{% for cm in ctx.qos_class_maps | default([]) %}
class-map type qos match-any {{ cm.name }}
{% for m in cm.match %}
   match {{ m }}
{% endfor %}
!
{% endfor %}
{% for pm in ctx.qos_policy_maps | default([]) %}
policy-map type qos {{ pm.name }}
{% for c in pm.classes %}
   class {{ c.name }}
{% for a in c.actions %}
      {{ a }}
{% endfor %}
{% endfor %}
!
{% endfor %}
{# endfeature #}
!
{# feature: sflow | detect: ^sflow #}
{% if ctx.sflow_collector is defined %}
sflow {{ vrfp }}destination {{ ctx.sflow_collector }}
sflow run
{% endif %}
{# endfeature #}
!
end
